# local enables /ai/dev/* endpoints
APP_ENV=local
APP_PORT=8186
LOG_LEVEL=INFO

# --- GLM (z.ai) ---
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Model IDs on z.ai: glm-5.3, glm-5, glm-4.7, glm-4.7-flashx, glm-4.7-flash, glm-4.5-air, glm-4.5-flash
# Default model; free models (glm-4.7-flash, glm-4.5-flash) must not be used (INV-9)
GLM_MODEL=glm-4.5-air
GLM_TIMEOUT_S=120
# stops an agent stuck in a tool loop
GLM_MAX_REQUESTS_PER_RUN=10

# --- Chat ---
# one message; the session history itself has no limit
CHAT_MAX_MESSAGE_CHARS=20000
CHAT_MAX_CONTEXT_CHARS=50000
# PDFs per message
CHAT_MAX_FILES=3
# keep-alive line on quiet streams so proxies don't cut them
CHAT_STREAM_HEARTBEAT_S=15

# --- PDF documents ---
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=20
# doctr | pdfium
PDF_EXTRACTOR=doctr
OCR_LANGS=vie,eng

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@occupify-postgres-agentic:5432/occupify_agentic
FALL_BACK_DB_URL=postgresql://postgres:postgres@localhost:5432/occupify_agentic

# --- RabbitMQ (shared) ---
RABBITMQ_URL=amqp://guest:guest@occupify-rabbitmq:5672/
RABBITMQ_RPC_TIMEOUT_S=10

# --- UC4 Job Matching & Migration ---
CORE_RPC_MODE=mock
CORE_MOCK_PATH=evals/uc4/data/catalog_scale_clean.json
CORE_MOCK_GET_OVERLAY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_MODELS_DIR=/opt/hf_models
ML_ENABLED=true
JOB_MATCH_TOOL_TIMEOUT_S=200

# CV generator
CV_GENERATOR_ENABLED=false
CV_GENERATOR_TIMEOUT_S=90
CV_GENERATOR_LINK_TTL_S=86400
# Container agentic uses cv-compiler; make run overrides this to localhost.
CV_COMPILER_URL=http://cv-compiler:8190
CV_COMPILER_PORT=8190
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: leave blank to derive the standard OCI S3 endpoint from namespace + region.
S3_ENDPOINT=
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET=

